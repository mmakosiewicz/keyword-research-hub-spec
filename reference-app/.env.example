# Required
DATABASE_URL=postgresql+psycopg2://keyword_hub:change-me@127.0.0.1:5432/keyword_hub
SECRET_KEY=replace-with-a-random-32-byte-value
APP_USERNAME=admin
APP_PASSWORD_HASH=replace-with-werkzeug-generate_password_hash-output

# LLM access is environment-only. Never commit a real key.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace-me
EMBED_MODEL=openai/text-embedding-3-small
BP_MODEL=anthropic/claude-opus-5
LABEL_MODEL=anthropic/claude-haiku-4.5

HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=10
SESSION_COOKIE_SECURE=true
# Explicitly set to 1 only behind a trusted external auth proxy.
ALLOW_PROXY_AUTH=0
